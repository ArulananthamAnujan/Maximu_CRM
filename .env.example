# Copy to .env.local for `next build` / Netlify, and to .dev.vars for the
# Cloudflare Worker used by `npm run dev`. Never commit either file.

# Supabase project URL, for example https://abcdefgh.supabase.co
SUPABASE_URL=

# The project's publishable ("anon") key. Requests are made with the signed-in
# user's access token on top of this key, so row-level security applies. Do not
# put the service-role key here: it bypasses row-level security entirely.
SUPABASE_PUBLISHABLE_KEY=
