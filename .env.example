# Copy to .env.local for `next build` / Netlify, and to .dev.vars for the
# Cloudflare Worker used by `npm run dev`. Never commit either file.

# Supabase project URL, for example https://abcdefgh.supabase.co
SUPABASE_URL=

# The project's publishable ("anon") key. Requests are made with the signed-in
# user's access token on top of this key, so row-level security applies. Do not
# put the service-role key here: it bypasses row-level security entirely.
SUPABASE_PUBLISHABLE_KEY=

# --- Google Shared Drive document storage (optional) ---------------------
# From the service account's JSON key. The service account must be a Content
# manager of the Shared Drive and must have no other access.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the escaped newlines exactly as they appear in the JSON key.
GOOGLE_PRIVATE_KEY=
# The Shared Drive id, from drive.google.com/drive/folders/<id>
GOOGLE_SHARED_DRIVE_ID=

# Largest single upload, in megabytes. Defaults to 25.
MAX_UPLOAD_MB=

# --- Protected fields ----------------------------------------------------
# Encrypts passport numbers before they reach the database, so a copy of the
# database alone does not disclose them. Generate with:
#   openssl rand -base64 32
# Changing it makes existing stored numbers unreadable.
FIELD_ENCRYPTION_KEY=
