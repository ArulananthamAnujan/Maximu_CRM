# Copy to .env.local for `next build` / Netlify, and to .dev.vars for the
# Cloudflare Worker used by `npm run dev`. Never commit either file.

# Supabase project URL, for example https://abcdefgh.supabase.co
SUPABASE_URL=

# The project's publishable ("anon") key. Requests are made with the signed-in
# user's access token on top of this key, so row-level security applies. Do not
# put the service-role key here: it bypasses row-level security entirely.
SUPABASE_PUBLISHABLE_KEY=

# --- Creating staff logins from inside the CRM (optional) ----------------
# The service-role key bypasses row-level security completely. It is used on
# exactly one path: an administrator adding a member of staff under Staff &
# Masters, where the Supabase login has to be created before the profile that
# points at it. Leave it unset and that screen records an invitation instead --
# you create the login yourself, and their account is set up on first sign-in.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Shared Drive document storage (optional) ---------------------
# From the service account's JSON key. The service account must be a Content
# manager of the Shared Drive and must have no other access.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the escaped newlines exactly as they appear in the JSON key.
GOOGLE_PRIVATE_KEY=
# The Shared Drive id, from drive.google.com/drive/folders/<id>
GOOGLE_SHARED_DRIVE_ID=

# Largest single upload, in megabytes. Defaults to 25.
MAX_UPLOAD_MB=

# --- Google OAuth client: Gmail, Calendar and Google sign-in (optional) ---
# One Web-application OAuth 2.0 client in Google Cloud, shared by three
# features: a staff member connecting their own Gmail, connecting their own
# Calendar, and the "Continue with Google" sign-in button. Its authorized
# redirect URIs must include, for this deployment's own domain:
#   <origin>/api/auth/gmail/callback
#   <origin>/api/auth/calendar/callback
#   <your-supabase-project-url>/auth/v1/callback   (sign-in only -- see below)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Google sign-in additionally requires switching the Google provider on in
# the Supabase dashboard itself (Authentication -> Providers -> Google), using
# this same client id and secret -- setting the two values above is not
# enough on its own for that one feature. See "Google sign-in setup" in
# README.md.

# --- System email: document/invoice requests, portal welcome (optional) --
# The CRM notifying a client itself -- distinct from a staff member's own
# Gmail sending as themselves. Sent through Resend (resend.com): create an
# account, verify a sending domain there, and generate an API key.
RESEND_API_KEY=
# Must be an address at the domain you verified with Resend, e.g.
# "Maximus CRM <notifications@youragency.com>".
RESEND_FROM_EMAIL=

# --- Protected fields ----------------------------------------------------
# Encrypts passport numbers before they reach the database, so a copy of the
# database alone does not disclose them. Generate with:
#   openssl rand -base64 32
# Changing it makes existing stored numbers unreadable.
FIELD_ENCRYPTION_KEY=
